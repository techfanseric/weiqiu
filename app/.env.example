# Replace with the existing backend origin for device integration.
# Demo display and the development preview do not require a backend.
VITE_API_BASE_URL=http://127.0.0.1:8080
# Optional confirmed same-origin GET endpoint returning a Display v1 snapshot.
# Leave blank until the backend team confirms an endpoint.
VITE_DISPLAY_SNAPSHOT_URL=
# iFlytek streaming speech-to-text (语音听写流式版) credentials for live voice
# captions on the display screen. Leave blank to fall back to the browser's
# built-in recognition. Keys can also be overridden at runtime via
# localStorage "voice.xfyun" = {"VITE_XFYUN_APP_ID":"...","VITE_XFYUN_API_KEY":"...","VITE_XFYUN_API_SECRET":"..."}.
VITE_XFYUN_APP_ID=
VITE_XFYUN_API_KEY=
VITE_XFYUN_API_SECRET=
