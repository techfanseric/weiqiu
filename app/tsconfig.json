{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["@types/node", "@arco-design/web-vue"]
  },
  "include": ["src/**/*", "src/**/*.vue", "src/env.d.ts", "mock/*.ts" ],
  "exclude": ["node_modules"]
}